# pnpm dev:mock 全 mock 模式：后端零参与，页面血肉全亮。
# 双重 gate：import.meta.env.DEV === true 且 VITE_USE_MOCK === 'true' 才激活。
# prod 构建时 import.meta.env.DEV 恒为 false，此值不参与判定。
VITE_USE_MOCK=true
# 开发 mock 默认注入 superadmin 的内存 access token，验收无需验证码。
# 仍受 import.meta.env.DEV 与显式 debug gate 保护，生产构建不会读取该接缝。
VITE_DEBUG_AUTH_ENABLED=true
VITE_DEBUG_AUTH_USER_ID=1
